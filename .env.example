# Documentation only. Use Cloudflare secrets for credentials; never commit .dev.vars.
TWILIO_ACCOUNT_SID=AC_REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_WHATSAPP_FROM=whatsapp:+15550000000
OWNER_WHATSAPP_NUMBER=whatsapp:+15550000001
TWILIO_UPDATE_CONTENT_SID=HX_REPLACE_WITH_APPROVED_CASE_UPDATE_TEMPLATE
OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=gpt-4o-mini
# Optional independent media model overrides.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_VISION_MODEL=gpt-4o-mini
VALIDATE_TWILIO_SIGNATURE=true
CONVERSATION_RETENTION_SECONDS=2592000
ADMIN_ACCESS_TEAM_DOMAIN=https://YOUR_TEAM.cloudflareaccess.com
ADMIN_ACCESS_AUDIENCE=REPLACE_ME
ADMIN_EMAILS=owner@example.com
CASE_STATUS_UPDATE_SECRET=REPLACE_WITH_RANDOM_SECRET
# Production bootstrap is a controlled migration, not an ordinary startup flag.
COORDINATOR_BOOTSTRAP_APPROVED=false
# Initial mode for an empty coordinator only; later mode changes use owner API.
# CUTOVER_MODE=hold
