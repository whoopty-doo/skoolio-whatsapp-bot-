{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skoolio-whatsapp-bot",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "observability": {
    "enabled": true
  },
  "vars": {
    "OPENAI_MODEL": "gpt-4o-mini",
    "VALIDATE_TWILIO_SIGNATURE": "true"
  },
  "kv_namespaces": [
    {
      "binding": "NOTES_KV",
      "id": "REPLACE_WITH_CLOUDFLARE_KV_NAMESPACE_ID"
    }
  ]
}